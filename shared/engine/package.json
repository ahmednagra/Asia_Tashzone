{
  "name": "@tashzone/engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/bundle.mjs && vitest run",
    "bundle": "node scripts/bundle.mjs",
    "bundle:profiles": "node scripts/bundle-profiles.mjs",
    "digest": "node scripts/digest.mjs"
  },
  "dependencies": {
    "@noble/ciphers": "2.4.0",
    "@noble/hashes": "2.4.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "fast-check": "4.10.2",
    "ajv": "8.20.0",
    "quickjs-emscripten": "0.32.0"
  }
}
