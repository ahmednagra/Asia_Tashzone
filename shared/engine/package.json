{
  "name": "@tashzone/engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/bundle.mjs && vitest run",
    "bundle": "node scripts/bundle.mjs",
    "bundle:profiles": "node scripts/bundle-profiles.mjs",
    "digest": "node scripts/digest.mjs"
  },
  "dependencies": {
    "@noble/ciphers": "1.1.3",
    "@noble/hashes": "1.6.1"
  },
  "devDependencies": {
    "esbuild": "0.24.2",
    "fast-check": "3.23.2",
    "ajv": "8.17.1",
    "quickjs-emscripten": "0.31.0"
  }
}
