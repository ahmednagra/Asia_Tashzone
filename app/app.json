{
  "expo": {
    "name": "TashZone",
    "slug": "tashzone",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tashzone.app",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "TashZone uses your local network only to find and join card tables hosted by people on the same Wi-Fi.",
        "NSBonjourServices": [
          "_tashzone._tcp"
        ]
      }
    },
    "android": {
      "package": "com.tashzone.app",
      "versionCode": 12,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.CHANGE_WIFI_MULTICAST_STATE"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-background.png"
      }
    },
    "extra": {
      "note": "API URL comes from EXPO_PUBLIC_API_URL; signing keys live in app/credentials/ and are never committed",
      "eas": {
        "projectId": "5ca7b4b8-fb4c-458e-95f5-e5d4c27f5360"
      }
    },
    "owner": "muhammad_ahmed",
    "plugins": [
      "./plugins/with-release-signing",
      "./plugins/with-build-hygiene",
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "TashZone uses the camera only to scan a table QR code. Nothing is recorded or saved.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#070F0D"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ]
    ],
    "scheme": "tashzone",
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/icon.png",
    "backgroundColor": "#070F0D",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/5ca7b4b8-fb4c-458e-95f5-e5d4c27f5360",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
